/-
Regenerate LeanTex/Core/HtmlEntityData.lean from testdata/vendor/whatwg-html-entities, refusing any
name or row it cannot read exactly once.
Usage: lake build scripts.GenData && lake env lean --run scripts/gen-html-entity-data.lean [--check]
-/
import scripts.GenData
import Lean.Data.Json

open GenData

open Lean

def source : System.FilePath := "testdata/vendor/whatwg-html-entities/entities.json"
def target : System.FilePath := "LeanTex/Core/HtmlEntityData.lean"

def hexDigit (v : Nat) : Char := "0123456789ABCDEF".toList[v % 16]!

/-- A scalar's upper-case hex digits, at least two. -/
def hex (v : Nat) : String := Id.run do
  let mut out := ""
  let mut n := v
  for _ in [0:8] do
    out := String.singleton (hexDigit n) ++ out
    n := n / 16
    if n == 0 && out.length ≥ 2 then break
  return out

def main (args : List String) : IO Unit := do
  let json ← match Json.parse (← IO.FS.readFile source) with
    | .ok j => pure j
    | .error e => die s!"entities.json: {e}"
  let fields ← match json.getObj? with
    | .ok o => pure o.toArray
    | .error e => die s!"entities.json: {e}"
  let mut rows : Array (String × Array Nat) := #[]
  let mut legacy := 0
  for ⟨key, v⟩ in fields do
    unless key.startsWith "&" do die s!"entities.json: the name {key} does not open with &"
    unless key.endsWith ";" do
      legacy := legacy + 1
      continue
    let name := ((key.drop 1).dropEnd 1).toString
    unless !name.isEmpty && name.all Char.isAlphanum do
      die s!"entities.json: the name {key} is not letters and digits"
    let some cps := (v.getObjValAs? (Array Nat) "codepoints").toOption
      | die s!"entities.json: {key} has no code points"
    let some chars := (v.getObjValAs? String "characters").toOption
      | die s!"entities.json: {key} has no characters"
    unless cps.size ≥ 1 && cps.size ≤ 2 do die s!"entities.json: {key} has {cps.size} code points"
    for cp in cps do
      unless cp ≤ 0x10FFFF && !(0xD800 ≤ cp && cp ≤ 0xDFFF) do
        die s!"entities.json: {key} names a code point that is no scalar"
    unless chars.toList.map Char.toNat == cps.toList do
      die s!"entities.json: {key}'s characters are not its code points"
    rows := rows.push (name, cps)
  let sorted := rows.qsort (fun a b => a.1 < b.1)
  for i in [1:sorted.size] do
    if sorted[i - 1]!.1 == sorted[i]!.1 then die s!"entities.json: {sorted[i]!.1} is named twice"
  if sorted.size != 2125 || legacy != 106 then
    die s!"expected 2125 names ending in ; and 106 legacy names, read {sorted.size} and {legacy}"
  let body := String.join (sorted.toList.map fun (n, cps) =>
    n ++ " " ++ "+".intercalate (cps.toList.map hex) ++ "\\n")
  let out :=
    "module\n\n/-\nGenerated by scripts/gen-html-entity-data.lean; do not edit by hand. Regenerate with:\n" ++
    "  lake env lean --run scripts/gen-html-entity-data.lean\n\n" ++
    "Source: testdata/vendor/whatwg-html-entities (the HTML Standard's entities.json;\n" ++
    "see its PROVENANCE.txt). This module carries only data: `HtmlEntity` reads it and\n" ++
    "states its contract.\n-/\n\n" ++
    "namespace LeanTex.Core.HtmlEntityData\n\n" ++
    "/-- Every named character reference ending in `;`, one per line, sorted: its name without\n" ++
    "`&` and `;`, a space, and its one or two scalars in upper-case hex joined by `+`. -/\n" ++
    "public def table : String :=\n  \"" ++ body ++ "\"\n\n" ++
    "end LeanTex.Core.HtmlEntityData\n"
  if args.contains "--check" then
    let committed ← IO.FS.readFile target
    unless committed == out do die s!"{target} is stale: regenerate it"
    IO.println s!"{target}: {sorted.size} names, current"
  else
    IO.FS.writeFile target out
    IO.println s!"wrote {target}: {sorted.size} names"
