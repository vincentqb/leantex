#!/bin/sh
# Pre-commit gate: compile+lint via lake build --wfail, plus convention checks
# over the staged diff. Silent on success. Install: git config core.hooksPath scripts/hooks
set -u

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

echo "$staged" | grep -qE '\.lean$|^lakefile\.(toml|lean)$|^lean-toolchain$|^tests/golden/' || exit 0

fail=0
say() { printf '%s\n' "$1" >&2; fail=1; }

if echo "$staged" | grep -qx 'lean-toolchain'; then
  if [ "$(echo "$staged" | grep -cvx 'lean-toolchain')" -gt 0 ]; then
    say "pre-commit: lean-toolchain changed together with other files.
  Toolchain bumps are deliberate and go in their own commit (AGENTS.md, Don't touch).
  Fix: git restore --staged lean-toolchain, commit the rest, then commit the bump alone."
  fi
fi

if echo "$staged" | grep -q '^tests/golden/'; then
  if ! echo "$staged" | grep -qE '\.lean$|^tests/corpus/.*\.tex$'; then
    say "pre-commit: tests/golden/** changed without a .lean or tests/corpus/*.tex change.
  Goldens are regenerated through the harness, never hand-edited (AGENTS.md, Don't touch).
  Fix: revert the golden files, or regenerate with: lake exe Tests --update"
  fi
fi

added=$(git diff --cached --no-color --unified=0 -- '*.lean' | grep '^+' | grep -v '^+++' || true)

bad=$(printf '%s\n' "$added" | grep -E '(^|[^[:alnum:]_])partial([^[:alnum:]_]|$)' \
      | grep -vE 'partial def (elabInlines|elabBlocks)' || true)
if [ -n "$bad" ]; then
  say "pre-commit: new 'partial' in staged .lean changes:
$bad
  Only Elab.elabInlines/elabBlocks may be partial (tracked in PLAN.md).
  Fix: make the recursion structural (see AGENTS.md, Conventions)."
fi

bad=$(printf '%s\n' "$added" | grep -E '(^|[^[:alnum:]_])sorry([^[:alnum:]_]|$)' || true)
if [ -n "$bad" ]; then
  say "pre-commit: 'sorry' in staged .lean changes:
$bad
  Fix: finish the proof; a broken theorem is a broken build."
fi

bad=$(printf '%s\n' "$added" | grep -E '(^|[^[:alnum:]_])unsafe([^[:alnum:]_]|$)' || true)
if [ -n "$bad" ]; then
  say "pre-commit: 'unsafe' in staged .lean changes:
$bad
  Fix: stay in the safe fragment; unsafe code voids the certification story."
fi

[ "$fail" -ne 0 ] && exit 1

if [ -z "${LEAN_CC:-}" ] && [ -x /home/linuxbrew/.linuxbrew/bin/clang ]; then
  export LEAN_CC=/home/linuxbrew/.linuxbrew/bin/clang
  export LIBRARY_PATH="$(lean --print-prefix)/lib:$(lean --print-prefix)/lib/lean"
fi

out=$(lake build --wfail -q 2>&1) || {
  printf '%s\n' "pre-commit: lake build --wfail failed (linter warnings fail too):" >&2
  printf '%s\n' "$out" >&2
  exit 1
}

exit 0
