#!/bin/sh
# Trampoline into scripts/precommit.lean, run only when the staged change can matter to it: a
# checked file kind, a conflict marker, an added path, a possible home path, or a local denylist.
# The compiled gate runs when current; a stale or missing binary is rebuilt first.
git diff --cached --name-only | grep -qE '\.lean$|^lakefile\.(toml|lean)$|^lean-toolchain$|^testdata/golden/|^PLAN\.md$|^(AGENTS|PRINCIPLES|THEOREMS)\.md$' \
  || git diff --cached --no-color --unified=0 | grep -qE '^\+(<{7}|>{7}|\|{7})([[:space:]]|$)' \
  || git diff --cached --name-only --no-renames --diff-filter=A | grep -q . \
  || git diff --cached --no-color --unified=0 | LC_ALL=C grep -E '^\+' \
     | LC_ALL=C grep -qE '(^|[^A-Za-z0-9._-])/(local/home|home|Users)/[A-Za-z0-9_]' \
  || [ -f "$(git rev-parse --git-common-dir)/info/private-terms" ] \
  || exit 0
b=.lake/build/bin/precommit
[ -x "$b" ] && [ ! scripts/precommit.lean -nt "$b" ] && [ ! scripts/Gate.lean -nt "$b" ] \
  && [ ! scripts/Privacy.lean -nt "$b" ] && exec "$b"
[ -z "$LEAN_CC" ] && [ -x /home/linuxbrew/.linuxbrew/bin/clang ] \
  && export LEAN_CC=/home/linuxbrew/.linuxbrew/bin/clang LIBRARY_PATH="$(lean --print-prefix)/lib:$(lean --print-prefix)/lib/lean"
lake build precommit --wfail -q >&2 && exec "$b"
echo "pre-commit: the gate itself failed to build (scripts/precommit.lean)" >&2
exit 1
