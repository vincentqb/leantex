#!/bin/sh
# Git executes a FILE here; the gate itself is scripts/precommit.lean. The
# greps keep irrelevant commits at ~0.02 s instead of paying lean startup:
# run the gate for the file kinds it checks, or when the staged diff adds a
# line-start conflict marker in any file (the marker gate covers the tree).
# The compiled gate runs when current; a stale or missing binary is rebuilt
# first (the gate's own build step keeps it current otherwise).
git diff --cached --name-only | grep -qE '\.lean$|^lakefile\.(toml|lean)$|^lean-toolchain$|^tests/golden/|^PLAN\.md$' \
  || git diff --cached --no-color --unified=0 | grep -qE '^\+(<{7}|>{7}|\|{7})([[:space:]]|$)' \
  || exit 0
b=.lake/build/bin/precommit
[ -x "$b" ] && [ ! scripts/precommit.lean -nt "$b" ] && [ ! scripts/Gate.lean -nt "$b" ] && exec "$b"
[ -z "$LEAN_CC" ] && [ -x /home/linuxbrew/.linuxbrew/bin/clang ] \
  && export LEAN_CC=/home/linuxbrew/.linuxbrew/bin/clang LIBRARY_PATH="$(lean --print-prefix)/lib:$(lean --print-prefix)/lib/lean"
lake build precommit --wfail -q >&2 && exec "$b"
echo "pre-commit: the gate itself failed to build (scripts/precommit.lean)" >&2
exit 1
