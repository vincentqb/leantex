#!/bin/sh
# Git executes a FILE here; the gate itself is scripts/precommit.lean. The
# greps keep irrelevant commits at ~0.02 s instead of paying lean startup:
# run the gate for the file kinds it checks, or when the staged diff adds a
# line-start conflict marker in any file (the marker gate covers the tree).
# The compiled gate runs when current (its own build step refreshes it);
# an outdated or missing binary falls back to interpreting the script.
git diff --cached --name-only | grep -qE '\.lean$|^lakefile\.(toml|lean)$|^lean-toolchain$|^tests/golden/|^PLAN\.md$' \
  || git diff --cached --no-color --unified=0 | grep -qE '^\+(<{7}|>{7}|\|{7})([[:space:]]|$)' \
  || exit 0
[ -x .lake/build/bin/precommit ] && [ ! scripts/precommit.lean -nt .lake/build/bin/precommit ] \
  && exec .lake/build/bin/precommit
exec lean --run scripts/precommit.lean
