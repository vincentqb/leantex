/-
Regenerate LeanTex/Core/CssColorData.lean from the vendored CSS named-colour table
(testdata/vendor/color-name/index.js), refusing a line of any other shape.
Usage: lake build scripts.GenData && lake env lean --run scripts/gen-csscolor-data.lean [--check]
-/
import scripts.GenData

open GenData

def source : System.FilePath := "testdata/vendor/color-name/index.js"
def target : System.FilePath := "LeanTex/Core/CssColorData.lean"

/-- One table line as its row, or `none` for the module's own frame. -/
def row (line : String) : Except String (Option (String × Nat × Nat × Nat)) := do
  let t := line.trimAscii.toString
  if t.isEmpty || t == "'use strict'" || t == "module.exports = {" || t == "};" then
    return none
  match t.splitOn "\": [" with
  | [name, rest] =>
    unless name.startsWith "\"" do throw s!"unreadable table line: {line}"
    let name := (name.drop 1).toString
    let nums := ((rest.replace "]," "").replace "]" "").splitOn ","
    match nums.map (·.trimAscii.toString.toNat?) with
    | [some r, some g, some b] =>
      unless r < 256 && g < 256 && b < 256 do throw s!"a channel out of range: {line}"
      unless name.toList.all Char.isLower do throw s!"a keyword not in lower case: {line}"
      return some (name, r, g, b)
    | _ => throw s!"unreadable channels: {line}"
  | _ => throw s!"unreadable table line: {line}"

def render (rows : Array (String × Nat × Nat × Nat)) : String :=
  let body := ",\n".intercalate (rows.toList.map fun (n, r, g, b) => s!"  (\"{n}\", {r}, {g}, {b})")
  "module\n\n/-\nGenerated by scripts/gen-csscolor-data.lean; do not edit by hand. Regenerate with:\n" ++
  "  lake env lean --run scripts/gen-csscolor-data.lean\n\n" ++
  "Source: testdata/vendor/color-name/index.js (color-name 1.1.4, MIT; see its\n" ++
  "PROVENANCE.txt): CSS Color 4's named colours and their sRGB channels, sorted by\n" ++
  "name. This module carries only data: `CssColor` reads it and states its contract.\n-/\n\n" ++
  "namespace LeanTex.Core.CssColorData\n\n" ++
  "/-- The named colours: keyword, red, green, blue. -/\n" ++
  "@[expose] public def table : Array (String × Nat × Nat × Nat) := #[\n" ++ body ++ "]\n\n" ++
  "end LeanTex.Core.CssColorData\n"

def main (args : List String) : IO Unit := do
  let text ← IO.FS.readFile source
  let mut rows : Array (String × Nat × Nat × Nat) := #[]
  for line in text.splitOn "\n" do
    match row line with
    | .error e => die e
    | .ok none => pure ()
    | .ok (some r) => rows := rows.push r
  let sorted := rows.qsort (fun a b => a.1 < b.1)
  if sorted.size != 148 then die s!"expected 148 named colours, read {sorted.size}"
  let out := render sorted
  if args.contains "--check" then
    let committed ← IO.FS.readFile target
    unless committed == out do die s!"{target} is stale: regenerate it"
    IO.println s!"{target}: {sorted.size} colours, current"
  else
    IO.FS.writeFile target out
    IO.println s!"wrote {target}: {sorted.size} colours"
