/-
Regenerate LeanTex/Core/PaletteData.lean: the palettes the class's default
seeds generate at the classes' two ground depths, each shipped bundle's
generated palette at both depths, and each colour a bundle derives from a
lineage colour — the generator's own answers (`SeedPalette.generate`,
`ContrastSolve.realizeNearest`), kept so no build derives a constant again.
Run from the repository root with:

  lake env lean --run scripts/gen-palette-data.lean          write the module
  lake env lean --run scripts/gen-palette-data.lean --check  exit 1 when it is stale

Nothing outside the engine is read: the seeds and relations are the engine's
own (`Ir.ClassColors`, `Theme.builtin`), so `Tests.PaletteData.checks`
derives every entry afresh in `lake test` too.
-/
import LeanTex.Core.Theme

open LeanTex.Core

def path : String := "LeanTex/Core/PaletteData.lean"

def hex (v : UInt8) : String :=
  let digits := Ir.Color.hexByte v
  "0x" ++ digits

def color (c : Ir.Color) : String :=
  s!"\{ r := {hex c.r}, g := {hex c.g}, b := {hex c.b} }"

def optColor : Option Ir.Color → String
  | some c => s!"some {color c}"
  | none => "none"

def colors (c : SeedPalette.Colors) (ind : String) : String :=
  let f (n : String) (v : String) := s!"{ind}  {n} := {v}"
  s!"\{\n" ++ String.intercalate "\n" [
    f "surface" (color c.surface), f "surfaceStrong" (color c.surfaceStrong),
    f "rule" (color c.rule), f "accentWash" (color c.accentWash),
    f "accentSoft" (color c.accentSoft), f "muted" (color c.muted),
    f "diagramMuted" (color c.diagramMuted), f "mutedOnInverse" (color c.mutedOnInverse),
    f "accentText" (color c.accentText), f "accentEdge" (color c.accentEdge),
    f "accentOnInverse" (color c.accentOnInverse), f "alert" (color c.alert),
    f "alertBand" (color c.alertBand), f "exampleText" (optColor c.exampleText),
    f "exampleBand" (color c.exampleBand)] ++ s!" }"

def depthName (d : Ir.GroundDepth) : String :=
  if d == .documents then ".documents" else if d == .decks then ".decks" else "{}"

def roleName (r : Ir.Role) : String := "." ++ (reprStr r).replace "LeanTex.Core.Ir.Role." ""

def depths : List Ir.GroundDepth := [.documents, .decks]

def render : Except String String := do
  let mut cls : Array String := #[]
  for d in depths do
    match SeedPalette.generate SeedPalette.classSeeds (SeedPalette.classSeeds.targets d) with
    | .ok g => cls := cls.push s!"  ({depthName d}, {colors g.colors "  "})"
    | .error f => throw s!"the class's seeds generate no palette at {depthName d}: {f.detail}"
  let mut gen : Array String := #[]
  let mut der : Array String := #[]
  for th in Theme.builtin do
    if th.seeds.isSome then
      for d in depths do
        match th.generatedFresh d with
        | some c => gen := gen.push s!"  (\"{th.name}\", {depthName d}, {colors c "  "})"
        | none => throw s!"'{th.name}''s seeds generate no palette at {depthName d}"
    for (r, seed) in th.derived do
      der := der.push s!"  (\"{th.name}\", {roleName r}, {color (th.derivedFresh seed)})"
  let list (xs : Array String) : String :=
    if xs.isEmpty then "[]" else "[\n" ++ ",\n".intercalate xs.toList ++ "]"
  let clsList := list cls
  let genList := list gen
  let derList := list der
  return "module\n\n" ++
    "/-\nGenerated by scripts/gen-palette-data.lean from the engine's own seeds and\n" ++
    "the shipped bundles' relations; do not edit by hand. Regenerate with:\n" ++
    "lake env lean --run scripts/gen-palette-data.lean\n\n" ++
    "The palettes the class's default seeds generate at the classes' two ground\n" ++
    "depths, the palettes a bundle's seeds generate, and the colours a bundle\n" ++
    "derives from a lineage colour: each the generator's own answer\n" ++
    "(`SeedPalette.generate`, `ContrastSolve.realizeNearest`), kept here so no\n" ++
    "build pays to derive a constant again. This module carries only data; the\n" ++
    "lookups over it live in the hand-owned Ir.lean and Theme.lean, and\n" ++
    "`Tests.PaletteData.checks` holds every entry to a fresh derivation.\n-/\n" ++
    "public import LeanTex.Core.SeedPalette\n\n" ++
    "namespace LeanTex.Core.PaletteData\n\nopen Ir\n\n" ++
    "/-- The class's default palette at each depth a class takes. -/\n" ++
    "@[expose] public def classGenerated : List (GroundDepth × SeedPalette.Colors) := " ++
      clsList ++ "\n\n" ++
    "/-- Each bundle's generated palette at each depth, by the bundle's name. -/\n" ++
    "@[expose] public def bundleGenerated : List (String × GroundDepth × SeedPalette.Colors) := " ++
      genList ++ "\n\n" ++
    "/-- Each colour a bundle derives from a lineage colour, by the bundle's name. -/\n" ++
    "@[expose] public def bundleDerived : List (String × Role × Color) := " ++ derList ++ "\n\n" ++
    "end LeanTex.Core.PaletteData\n"

def main (args : List String) : IO UInt32 := do
  match render with
  | .error msg =>
    IO.eprintln s!"gen-palette-data: {msg}"
    return 2
  | .ok text =>
    if args == ["--check"] then
      let current ← IO.FS.readFile path
      if current == text then return 0
      IO.eprintln s!"gen-palette-data: {path} is stale; regenerate it"
      return 1
    IO.FS.writeFile path text
    IO.println s!"gen-palette-data: wrote {path}"
    return 0
