/-
Regenerate LeanTex/Core/BibStringsData.lean from english.lbx's bibliography strings (via
kpsewhich).
Usage: lake env lean --run scripts/gen-bibstrings-data.lean
-/

def die (msg : String) : IO α := do
  IO.eprintln msg
  IO.Process.exit 1

def locate (file : String) : IO String := do
  let out ← try
    IO.Process.output { cmd := "kpsewhich", args := #[file] }
  catch _ =>
    die s!"kpsewhich not found; it locates {file}"
  let path := out.stdout.trimAscii.toString
  if out.exitCode != 0 || path.isEmpty then
    die s!"kpsewhich could not find {file}"
  return path

/-- The file with every TeX comment removed, its lines kept. -/
def uncommented (text : String) : String := Id.run do
  let mut out := ""
  for line in text.splitOn "\n" do
    let mut prev := ' '
    for c in line.toList do
      if c == '%' && prev != '\\' then break
      out := out.push c
      prev := c
    out := out.push '\n'
  return out

/-- The balanced group opening at `cs[i]`: its body and the index after it. -/
def groupAt (cs : Array Char) (i : Nat) : Option (String × Nat) := Id.run do
  if cs[i]? != some '{' then return none
  let mut depth := 0
  let mut body := ""
  let mut j := i
  for _ in [0:cs.size] do
    match cs[j]? with
    | some c =>
      if c == '{' then
        depth := depth + 1
        if depth > 1 then body := body.push c
      else if c == '}' then
        depth := depth - 1
        if depth == 0 then return some (body, j + 1)
        body := body.push c
      else body := body.push c
      j := j + 1
    | none => return none
  return none

def skipJunk (cs : Array Char) (i : Nat) : Nat := Id.run do
  let mut j := i
  for _ in [0:cs.size] do
    match cs[j]? with
    | some c => if c.isWhitespace || c == ',' then j := j + 1 else break
    | none => break
  return j

/-- A form's TeX, its line breaks and runs of white space one space. -/
def squash (s : String) : String :=
  " ".intercalate (((s.replace "\n" " ").splitOn " ").filter (!·.isEmpty))

/-- The `key = {{long}{short}}` declarations of one strings block. -/
def declarations (body : String) : Array (String × String × String) := Id.run do
  let cs := body.toList.toArray
  let mut out : Array (String × String × String) := #[]
  let mut i := skipJunk cs 0
  for _ in [0:cs.size] do
    if i ≥ cs.size then break
    let mut key := ""
    let mut j := i
    for _ in [0:cs.size] do
      match cs[j]? with
      | some c => if c.isAlphanum then key := key.push c; j := j + 1 else break
      | none => break
    for _ in [0:cs.size] do
      match cs[j]? with
      | some c => if c.isWhitespace || c == '=' then j := j + 1 else break
      | none => break
    match groupAt cs j with
    | some (pair, k) =>
      let pcs := pair.trimAscii.toString.toList.toArray
      match groupAt pcs 0 with
      | some (long, k2) =>
        let k3 := (skipJunk pcs k2)
        match groupAt pcs k3 with
        | some (short, _) =>
          unless key.isEmpty do out := out.push (key, squash long, squash short)
        | none => pure ()
      | none => pure ()
      i := skipJunk cs k
    | none => break
  return out

def strLit (s : String) : String :=
  "\"" ++ (s.replace "\\" "\\\\").replace "\"" "\\\"" ++ "\""

/-- The value of `\def\name{value}` in a file. -/
def defValue (text name : String) : String :=
  match (text.splitOn ("\\def\\" ++ name ++ "{"))[1]? with
  | some rest => (rest.splitOn "}").headD ""
  | none => "?"

def main : IO UInt32 := do
  let lbx ← IO.FS.readFile (← locate "english.lbx")
  let sty ← IO.FS.readFile (← locate "biblatex.sty")
  let text := uncommented lbx
  let some rest := (text.splitOn "\\DeclareBibliographyStrings{")[1]?
    | die "english.lbx declares no strings: the source changed shape"
  let cs := ("{" ++ rest).toList.toArray
  let some (block, _) := groupAt cs 0 | die "the strings block never closes"
  let rows := declarations block
  if rows.size < 300 || !rows.any (·.1 == "editor") || !rows.any (·.1 == "nodate") then
    die s!"read {rows.size} strings: the source changed shape"
  let body := String.intercalate ",\n   " (rows.toList.map fun (k, l, s) =>
    s!"({strLit k}, {strLit l}, {strLit s})")
  let out := s!"module\n\n/-
Generated by scripts/gen-bibstrings-data.lean; do not edit by hand. Regenerate with:
  lake env lean --run scripts/gen-bibstrings-data.lean

Source, read from the TeX tree and never vendored:
- english.lbx, biblatex {defValue sty "abx@version"} ({defValue sty "abx@date"})
Each row is a bibliography string's key, its long form and its short form,
as the TeX the localization writes them in. This module carries only data:
the reference list reads it through `Bib.bibStringPieces`, and its contracts
are checked by the suite.

licence: english.lbx is part of biblatex, released under the LaTeX Project
Public License (LPPL), version 1.3c.
-/

namespace LeanTex.Core.BibStringsData

/-- english.lbx's `\\DeclareBibliographyStrings`: key, long form, short form. -/
public def english : List (String × String × String) :=
  [{body}]

end LeanTex.Core.BibStringsData
"
  IO.FS.writeFile "LeanTex/Core/BibStringsData.lean" out
  IO.println s!"wrote {rows.size} strings"
  return 0
