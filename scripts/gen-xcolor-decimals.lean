/-
Regenerate testdata/oracles/xcolor-html-decimals.tsv: the DeviceRGB decimal lualatex's xcolor
writes for each HTML byte, read off one uncompressed probe; needs lualatex and xcolor.
Usage: lake env lean --run scripts/gen-xcolor-decimals.lean [--check]
-/

def path : String := "testdata/oracles/xcolor-html-decimals.tsv"

def hex2 (n : Nat) : String :=
  let d (k : Nat) : Char := if k < 10 then Char.ofNat (48 + k) else Char.ofNat (55 + k)
  String.ofList [d (n / 16), d (n % 16)]

def probe : String :=
  "\\pdfvariable compresslevel=0\n\\pdfvariable objcompresslevel=0\n" ++
  "\\documentclass{article}\n\\usepackage{xcolor}\n\\begin{document}\n" ++
  String.join ((List.range 256).map fun v => s!"\\textcolor[HTML]\{{hex2 v}0000}\{x}\n") ++
  "\\end{document}\n"

/-- The first component of every `r g b rg` operator, in stream order. -/
def fillReds (text : String) : List String :=
  (text.splitOn " rg").dropLast.filterMap fun before =>
    match (before.splitOn "\n").getLast?.map (·.splitOn " ") with
    | some parts =>
      match parts.reverse with
      | _ :: _ :: r :: _ => some r
      | _ => none
    | none => none

def version (tool : String) (args : Array String) : IO String := do
  let out ← IO.Process.output { cmd := tool, args }
  return ((out.stdout.splitOn "\n").headD "").trimAscii.toString

def render : IO (Except String String) := do
  let dir := System.FilePath.mk ".lake" / "xcolor-decimals"
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir / "probe.tex") probe
  let args := #["-interaction=nonstopmode", "-halt-on-error", "probe.tex"]
  let run ← IO.Process.output { cmd := "lualatex", args, cwd := some dir }
  if run.exitCode != 0 then
    let tail := String.ofList (run.stdout.toList.reverse.take 400).reverse
    return .error s!"lualatex failed: {tail}"
  let pdf ← IO.FS.readBinFile (dir / "probe.pdf")
  let text := String.ofList (pdf.toList.map fun b => if b < 128 then Char.ofNat b.toNat else '?')
  let reds := fillReds text
  if reds.length != 256 then return .error s!"expected 256 fill operators, read {reds.length}"
  let lua ← version "lualatex" #["--version"]
  let log ← IO.FS.readFile (dir / "probe.log")
  let xcolor := ((log.splitOn "\n").find? (·.startsWith "Package: xcolor")).getD "Package: xcolor (unknown)"
  let rows := (List.range 256).zip reds |>.map fun (v, r) => s!"{hex2 v}\t{r}"
  return .ok ("# generated by scripts/gen-xcolor-decimals.lean — do not hand-edit\n" ++
    s!"# {lua}; {xcolor}\n" ++
    "# xcolor's HTML model, one \\textcolor[HTML]{XX0000} per byte\n" ++
    "byte\tdecimal\n" ++ "\n".intercalate rows ++ "\n")

/-- The table's data lines, which `--check` compares. -/
def dataLines (text : String) : List String :=
  (text.splitOn "\n").filter fun l => !l.startsWith "#"

def main (args : List String) : IO UInt32 := do
  match ← render with
  | .error msg =>
    IO.eprintln s!"gen-xcolor-decimals: {msg}"
    return 2
  | .ok text =>
    if args == ["--check"] then
      let current ← IO.FS.readFile path
      if dataLines current == dataLines text then return 0
      IO.eprintln s!"gen-xcolor-decimals: {path} is stale; regenerate it"
      return 1
    IO.FS.writeFile path text
    IO.println s!"gen-xcolor-decimals: wrote {path}"
    return 0
