/-
Regenerate LeanTex/Core/WhatwgEncodingData.lean from testdata/vendor/whatwg-encoding, refusing
any line, pointer or label it cannot read exactly once.
Usage: lake build scripts.GenData && lake env lean --run scripts/gen-whatwg-encoding-data.lean [--check]
-/
import scripts.GenData
import Lean.Data.Json

open GenData

open Lean

def dir : System.FilePath := "testdata/vendor/whatwg-encoding"
def target : System.FilePath := "LeanTex/Core/WhatwgEncodingData.lean"

/-- The index file a single-byte encoding reads (ISO-8859-8-I shares
ISO-8859-8's, as the standard says). -/
def indexFile (name : String) : System.FilePath :=
  let n := if name == "ISO-8859-8-I" then "iso-8859-8" else name.toLower
  dir / s!"index-{n}.txt"

def hexDigit (v : Nat) : Char := "0123456789ABCDEF".toList[v % 16]!

def hex4 (v : Nat) : String :=
  String.ofList [hexDigit (v / 4096), hexDigit (v / 256), hexDigit (v / 16), hexDigit v]

/-- An index file's 128 scalars, 0 where a pointer is absent. -/
def readIndex (name : String) : IO (Array Nat) := do
  let text ← IO.FS.readFile (indexFile name)
  let mut out : Array Nat := Array.replicate 128 0
  let mut seen : Array Bool := Array.replicate 128 false
  for line in text.splitOn "\n" do
    let t := line.trimAscii.toString
    if t.isEmpty || t.startsWith "#" then continue
    match (t.splitOn "\t").map (·.trimAscii.toString) with
    | p :: cp :: _ =>
      let some ptr := p.toNat? | die s!"{name}: unreadable pointer in: {line}"
      unless cp.startsWith "0x" do die s!"{name}: unreadable code point in: {line}"
      let digits := (cp.drop 2).toString
      let v := digits.foldl (fun acc c =>
        acc * 16 + (if c.isDigit then c.toNat - 48 else c.toLower.toNat - 87)) 0
      unless digits.all (fun c => c.isDigit || ('A' ≤ c && c ≤ 'F') || ('a' ≤ c && c ≤ 'f')) &&
          !digits.isEmpty do die s!"{name}: unreadable code point in: {line}"
      unless ptr < 128 do die s!"{name}: pointer {ptr} past a single-byte index"
      if seen[ptr]! then die s!"{name}: pointer {ptr} twice"
      unless 0 < v && v < 0x10000 && !(0xD800 ≤ v && v ≤ 0xDFFF) do
        die s!"{name}: pointer {ptr} names U+{hex4 v}, which no single-byte index holds"
      out := out.set! ptr v
      seen := seen.set! ptr true
    | _ => die s!"{name}: unreadable line: {line}"
  return out

def main (args : List String) : IO Unit := do
  let json ← match Json.parse (← IO.FS.readFile (dir / "encodings.json")) with
    | .ok j => pure j
    | .error e => die s!"encodings.json: {e}"
  let groups ← match json.getArr? with
    | .ok gs => pure gs
    | .error e => die s!"encodings.json: {e}"
  let mut labels : Array (String × String) := #[]
  let mut single : Array String := #[]
  for g in groups do
    let heading := (g.getObjValAs? String "heading").toOption.getD ""
    let some encs := (g.getObjVal? "encodings" >>= Json.getArr?).toOption
      | die s!"encodings.json: a group without encodings ({heading})"
    for e in encs do
      let some name := (e.getObjValAs? String "name").toOption | die "encodings.json: an encoding without a name"
      let some ls := (e.getObjValAs? (Array String) "labels").toOption
        | die s!"encodings.json: {name} has no labels"
      for l in ls do
        if labels.any (·.1 == l) then die s!"encodings.json: the label {l} is named twice"
        unless l == l.toLower do die s!"encodings.json: the label {l} is not lower case"
        labels := labels.push (l, name)
      if heading == "Legacy single-byte encodings" then single := single.push name
  if single.size != 28 then die s!"expected 28 legacy single-byte encodings, read {single.size}"
  let mut tables : Array (String × String) := #[]
  for name in single do
    let idx ← readIndex name
    tables := tables.push (name, String.join (idx.toList.map hex4))
  let sorted := labels.qsort (fun a b => a.1 < b.1)
  let labelRows := ",\n".intercalate (sorted.toList.map fun (l, n) => s!"  (\"{l}\", \"{n}\")")
  let tableRows := ",\n".intercalate (tables.toList.map fun (n, t) => s!"  (\"{n}\",\n    \"{t}\")")
  let out :=
    "module\n\n/-\nGenerated by scripts/gen-whatwg-encoding-data.lean; do not edit by hand. Regenerate with:\n" ++
    "  lake env lean --run scripts/gen-whatwg-encoding-data.lean\n\n" ++
    "Source: testdata/vendor/whatwg-encoding (the WHATWG Encoding Standard's\n" ++
    "encodings.json and legacy single-byte indexes; see its PROVENANCE.txt).\n" ++
    "This module carries only data: `WhatwgEncoding` reads it and states its contract.\n-/\n\n" ++
    "namespace LeanTex.Core.WhatwgEncodingData\n\n" ++
    "/-- Every label the standard names, lower case, and the encoding it names:\n" ++
    "sorted by label. -/\n" ++
    "@[expose] public def labels : Array (String × String) := #[\n" ++ labelRows ++ "]\n\n" ++
    "/-- Each legacy single-byte encoding's index: for each byte from 0x80, the\n" ++
    "scalar it decodes to, four upper-case hex digits; `0000` where the index\n" ++
    "has no pointer, a byte the encoding does not map. -/\n" ++
    "@[expose] public def singleByte : Array (String × String) := #[\n" ++ tableRows ++ "]\n\n" ++
    "end LeanTex.Core.WhatwgEncodingData\n"
  if args.contains "--check" then
    let committed ← IO.FS.readFile target
    unless committed == out do die s!"{target} is stale: regenerate it"
    IO.println s!"{target}: {sorted.size} labels, {tables.size} single-byte indexes, current"
  else
    IO.FS.writeFile target out
    IO.println s!"wrote {target}: {sorted.size} labels, {tables.size} single-byte indexes"
