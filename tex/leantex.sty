\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{leantex}[2026/10/16 Lean files in LaTeX documents, as leantex reads them]
\RequirePackage{minted}
\ExplSyntaxOn
\tl_new:N \l__leantex_show_tl
\tl_new:N \l__leantex_decls_tl
\tl_new:N \l__leantex_proofs_tl
\tl_new:N \l__leantex_link_tl
\bool_new:N \l__leantex_phrased_bool
\keys_define:nn { leantex }
  {
    show .tl_set:N = \l__leantex_show_tl ,
    decls .tl_set:N = \l__leantex_decls_tl ,
    proofs .tl_set:N = \l__leantex_proofs_tl ,
    link .tl_set:N = \l__leantex_link_tl ,
    facts .code:n = { } ,
    bibliography .code:n = { } ,
    biblio-style .code:n =
      \PackageWarning { leantex }
        { \token_to_str:N \inputlean \c_space_tl takes ~ no ~ 'biblio-style': ~ its ~ citations ~
          set ~ in ~ the ~ document's ~ style ~ (ignored) } ,
    code .code:n = \tl_put_right:Nn \l__leantex_show_tl { , code } ,
    math .code:n = \tl_put_right:Nn \l__leantex_show_tl { , math } ,
    prose .code:n = \tl_put_right:Nn \l__leantex_show_tl { , prose } ,
    docs .code:n = \tl_put_right:Nn \l__leantex_show_tl { , docs } ,
    unknown .code:n =
      \str_if_eq:eeTF { \str_range:Nnn \l_keys_key_str { 1 } { 7 } } { phrase. }
        { \bool_set_true:N \l__leantex_phrased_bool }
        {
          \PackageWarning { leantex }
            { \token_to_str:N \inputlean \c_space_tl has ~ no ~ option ~ '\l_keys_key_str' ~ (ignored) }
        } ,
  }
\NewDocumentCommand \inputlean { O{} m }
  {
    \group_begin:
    \tl_set:Nn \l__leantex_show_tl { code }
    \tl_clear:N \l__leantex_decls_tl
    \tl_set:Nn \l__leantex_proofs_tl { show }
    \tl_clear:N \l__leantex_link_tl
    \bool_set_false:N \l__leantex_phrased_bool
    \keys_set:nn { leantex } { #1 }
    \bool_if:nF
      {
        \str_if_eq_p:Vn \l__leantex_show_tl { code }
        && \tl_if_empty_p:N \l__leantex_decls_tl
        && \str_if_eq_p:Vn \l__leantex_proofs_tl { show }
        && \tl_if_empty_p:N \l__leantex_link_tl
        && ! \l__leantex_phrased_bool
      }
      {
        \PackageWarning { leantex }
          { \token_to_str:N \inputlean { #2 } ~ sets ~ the ~ whole ~ file ~ as ~ code; ~
            statements, ~ phrases, ~ chosen ~ declarations, ~ folded ~ proofs, ~ links ~ and ~
            documentation ~ need ~ leantex }
      }
    \inputminted [ breaklines ] { lean4 } { #2 }
    \group_end:
  }
\ExplSyntaxOff
\endinput
