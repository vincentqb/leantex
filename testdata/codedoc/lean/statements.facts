{"command":[6,0,6,14],"text":"namespace Tide"}
{"command":[8,0,9,43],"text":"/-- The height a tide reaches after `n` steps of `rise`. -/\ndef height (rise n : Nat) : Nat := rise * n"}
{"command":[11,0,13,49],"text":"/-- Rising twice as long reaches twice as high. -/\ntheorem height_double (rise n : Nat) : height rise (2 * n) = 2 * height rise n := by\n  unfold height; exact Nat.mul_left_comm rise 2 n"}
{"command":[15,0,16,40],"text":"theorem height_pos {rise n : Nat} (hr : 0 < rise) (hn : 0 < n) : 0 < height rise n := by\n  unfold height; exact Nat.mul_pos hr hn"}
{"command":[18,0,18,54],"text":"theorem exists_step : ∃ n : Nat, n + 2 = 5 := ⟨3, rfl⟩"}
{"command":[20,0,20,56],"text":"theorem le_or_gt (a b : Nat) : a ≤ b ∨ b < a := by omega"}
{"command":[22,0,22,57],"text":"theorem swap_and (p q : Prop) : p ∧ q ↔ q ∧ p := And.comm"}
{"command":[24,0,24,59],"text":"theorem not_both (p : Prop) : ¬(p ∧ ¬p) := fun h => h.2 h.1"}
{"command":[26,0,26,74],"text":"theorem pow_succ' (a n : Nat) : a ^ (n + 1) = a ^ n * a := Nat.pow_succ .."}
{"command":[28,0,28,78],"text":"theorem mem_cons (x : Nat) (xs : List Nat) : x ∈ x :: xs := List.mem_cons_self"}
{"command":[30,0,30,56],"text":"theorem sub_le (a b : Nat) : a - b ≤ a := Nat.sub_le a b"}
{"command":[32,0,32,76],"text":"theorem div_mod (a b : Nat) : b * (a / b) + a % b = a := Nat.div_add_mod a b"}
{"command":[34,0,34,64],"text":"theorem dvd_mul (a b : Nat) : a ∣ a * b := Nat.dvd_mul_right a b"}
{"command":[36,0,36,55],"text":"theorem neg_neg' (z : Int) : -(-z) = z := Int.neg_neg z"}
{"command":[38,0,38,82],"text":"def total {α : Type} [Add α] (zero : α) (xs : List α) : α := xs.foldl (· + ·) zero"}
{"command":[40,0,42,7],"text":"theorem strict_hyp (h : ∀ ⦃n : Nat⦄, n = 0) : False := by\n  have := @h 1\n  omega"}
{"command":[44,0,44,56],"text":"theorem imp_iff (p q : Prop) (_h : p) : q ↔ q := Iff.rfl"}
{"command":[46,0,46,28],"text":"private def depth : Nat := 7"}
{"command":[48,0,48,36],"text":"theorem depth_val : depth = 7 := rfl"}
{"command":[50,0,50,32],"text":"def holds (p : Prop) : Prop := p"}
{"command":[52,0,52,55],"text":"theorem holds_ex : holds (∃ n : Nat, n = 0) := ⟨0, rfl⟩"}
{"command":[54,0,54,73],"text":"theorem fixes (f : Nat → Nat) (h : f 0 = 0) : f (f 0) = 0 := by rw [h, h]"}
{"command":[56,0,58,49],"text":"open Nat in\n/-- Read under an open namespace. -/\ntheorem succ_eq (n : Nat) : succ n = n + 1 := rfl"}
{"command":[60,0,61,58],"text":"open Nat in\ntheorem succ_pos' (n : Nat) : 0 < succ n := Nat.succ_pos n"}
{"command":[63,0,63,55],"text":"theorem iff_nest (p : Prop) : p ↔ (p ↔ True) := by simp"}
{"command":[65,0,65,62],"text":"theorem chars_len : \"a~b^c\\\\d\\n\\t\\\"{}_#$%&\".length = 17 := rfl"}
{"command":[67,0,67,10],"text":"universe u"}
{"command":[69,0,69,38],"text":"def same (α : Type u) (a : α) : α := a"}
{"command":[71,0,71,56],"text":"theorem pos_ne {n : Nat} {h : n > 0} : n ≠ 0 := by omega"}
{"command":[73,0,73,54],"text":"theorem nz (n : Nat) [NeZero n] : n ≠ 0 := NeZero.ne n"}
{"command":[75,0,75,71],"text":"theorem dep_hyp (n : Nat) (h : 0 < n) : (⟨0, h⟩ : Fin n).val = 0 := rfl"}
{"command":[77,0,78,33],"text":"theorem nested_dep (f : (n : Nat) → n > 0 → Nat) (hf : ∀ n (h : n > 0), f n h = n) :\n    f 1 Nat.one_pos = 1 := hf 1 _"}
{"command":[80,0,82,87],"text":"theorem long_sum (a b c d e f g h i j k l m n o p q r : Nat) :\n    a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r =\n      r + q + p + o + n + m + l + k + j + i + h + g + f + e + d + c + b + a := by omega"}
{"command":[84,0,84,50],"text":"theorem ge_zero (n : Nat) : n ≥ 0 := Nat.zero_le n"}
{"command":[86,0,86,64],"text":"theorem ordered_pair : ∃ a b : Nat, a < b := ⟨0, 1, Nat.one_pos⟩"}
{"command":[88,0,88,50],"text":"theorem refl_any (α : Type) (a : α) : a = a := rfl"}
{"command":[90,0,90,57],"text":"theorem not_lt_self (n : Nat) : ¬n < n := Nat.lt_irrefl n"}
{"command":[92,0,92,89],"text":"theorem inhabited_nonempty (h : ∀ (α : Type) [Inhabited α], Nonempty α) : True := trivial"}
{"command":[94,0,95,22],"text":"theorem unfinished (n : Nat) : n + 0 = n := by\n  exact Nat.zero_add n"}
{"command":[97,0,97,51],"text":"theorem rests (n : Nat) : n + 0 = n := unfinished n"}
{"command":[99,0,99,58],"text":"theorem placeholder (n : Nat) : n = Nat.notAThing n := rfl"}
{"command":[101,0,101,55],"text":"theorem refused (n : Nat) : n + (1 : String) = n := rfl"}
{"command":[103,0,103,8],"text":"end Tide"}
{"leantex-lean-export-end":39}
