{
  "Lean4Lexer": {
    "root": {
      "because": "Pygments' \\b# matches only after a word character, and Lean's own highlighter reads # and a name where a command starts, a line's first token or after in, as a keyword, #exit as sorry-like and #print's words as keywords",
      "check": "hashCommandChecks",
      "fires": ["#check x", "  #eval 1", "x\n\t#exit", "open Foo in #check x", "#print axioms f"],
      "holds": ["x := #s", "(#s)", "x := #α", "#[1, 2]", "x #check", "x#check", "@[#check]"],
      "rules": [
        ["(?:((?:\\A|\\s*\\n)[ \\t]*)|\\b(in)(\\s*))(#print)(\\s+)(sig|axioms|equations|eqns)\\b", "Text.Whitespace", "Keyword", "Text.Whitespace", "Keyword.Namespace", "Text.Whitespace", "Keyword"],
        ["(?:((?:\\A|\\s*\\n)[ \\t]*)|\\b(in)(\\s*))(#print)(\\s+)(tactic)(\\s+)(tags)\\b", "Text.Whitespace", "Keyword", "Text.Whitespace", "Keyword.Namespace", "Text.Whitespace", "Keyword", "Text.Whitespace", "Keyword"],
        ["(?:((?:\\A|\\s*\\n)[ \\t]*)|\\b(in)(\\s*))(#exit)\\b", "Text.Whitespace", "Keyword", "Text.Whitespace", "Generic.Error"],
        ["(?:((?:\\A|\\s*\\n)[ \\t]*)|\\b(in)(\\s*))(#<lean-segment>)", "Text.Whitespace", "Keyword", "Text.Whitespace", "Keyword.Namespace"]
      ]
    }
  }
}
