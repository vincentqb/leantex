{"command":[6,0,6,14],"text":"namespace Weir"}
{"command":[8,0,15,19],"text":"/-- A negated conjunction and a quantified hypothesis, each wider than the measure. -/\ntheorem gate_flow (a b c d : Nat)\n    (_h : Not (And (a < b) (Or (b < c) (Or (c < d) (d + a < b + c))))) :\n    (forall n : Nat, n < a ->\n      And (Or (n < b) (Or (n + 1 < c) (n + 2 < d)))\n        (Exists fun m : Nat => And (m < c) (And (n + m < d) (m + n < a + b + c + d)))) ->\n    a + b <= a + b + c + d :=\n  fun _ => by omega"}
{"command":[17,0,17,8],"text":"end Weir"}
{"leantex-lean-export-end":1}
