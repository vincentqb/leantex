{"command":[7,0,7,13],"text":"namespace Ebb"}
{"command":[9,0,11,25],"text":"/-- A quantified hypothesis stands as a block under its condition. -/\ntheorem none_all (h : forall n : Nat, n = 0) : False :=\n  absurd (h 1) (by omega)"}
{"command":[13,0,14,61],"text":"/-- An equivalence a conclusion holds stands as a block under it. -/\ntheorem iff_after (p q : Prop) (_hp : p) : q <-> q := Iff.rfl"}
{"command":[16,0,17,59],"text":"/-- An equivalence of conjunctions under a quantifier sets each side a block deeper. -/\ntheorem swap (p q : Prop) : And p q <-> And q p := And.comm"}
{"command":[19,0,20,34],"text":"theorem neg_all : Not (forall n : Nat, n = 0) :=\n  fun h => absurd (h 1) (by omega)"}
{"command":[22,0,23,44],"text":"theorem both_all : And (forall n : Nat, 0 <= n) (exists m : Nat, m = m) :=\n  And.intro Nat.zero_le (Exists.intro 0 rfl)"}
{"command":[25,0,26,20],"text":"theorem chain (a b c : Nat) (h1 : a <= b) (h2 : b <= c) : a <= c :=\n  Nat.le_trans h1 h2"}
{"command":[28,0,30,14],"text":"structure Crate where\n  id : Nat\n  weight : Nat"}
{"command":[32,0,32,44],"text":"def Heavy (c : Crate) : Prop := 0 < c.weight"}
{"command":[34,0,36,17],"text":"def ledger (cs : List Crate) (_bin : String) (_log : List (String × Nat)) :\n    List String × Nat :=\n  ([], cs.length)"}
{"command":[38,0,38,49],"text":"def labelOf (c : Crate) : String := toString c.id"}
{"command":[40,0,42,13],"text":"def FairSwap (_bin : String) (_log : List (String × Nat)) (_cs : List Crate)\n    (c d : Crate) : Prop :=\n  c.id = d.id"}
{"command":[44,0,44,40],"text":"def samples (_n : Nat) : List Bool := []"}
{"command":[46,0,46,33],"text":"def allSet (b : Bool) : Bool := b"}
{"command":[48,0,48,35],"text":"def weightOdds (n : Nat) : Nat := n"}
{"command":[50,0,61,18],"text":"/-- Three clauses over typed parameters, a witness pair and an identity of lengths. -/\ntheorem ledger_summary (cs : List Crate) (bin : String)\n    (log : List (String × Nat)) :\n    And (forall c, Membership.mem cs c -> Or (Heavy c) (c.weight = 0))\n      (And (forall tag, Membership.mem (ledger cs bin log).1 tag -> exists c d,\n          And (tag = labelOf d) (FairSwap bin log (cs.take 2) c d))\n        (forall n, 1 <= n ->\n          (samples n).length = (samples n).countP allSet * weightOdds n)) := by\n  refine And.intro (fun c _ => ?_) (And.intro (fun tag h => ?_) (fun n _ => ?_))\n  · unfold Heavy; omega\n  · simp [ledger] at h\n  · simp [samples]"}
{"command":[63,0,72,29],"text":"/-- Three clauses, the second of two clauses its own. -/\ntheorem crate_bounds (cs : List Crate) (cap : Nat) :\n    And (forall c, Membership.mem cs c -> c.weight <= c.weight + cap)\n      (And (forall c, Membership.mem cs c ->\n          And (forall k : Nat, k < c.id -> k + 1 <= c.id)\n            (exists m : Nat, m = c.weight + cap))\n        (cs.length <= cs.length + cap)) :=\n  And.intro (fun _ _ => Nat.le_add_right _ _)\n    (And.intro (fun _ _ => And.intro (fun _ hk => hk) (Exists.intro _ rfl))\n      (Nat.le_add_right _ _))"}
{"command":[74,0,74,7],"text":"end Ebb"}
{"leantex-lean-export-end":15}
