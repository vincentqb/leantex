{"command":[7,0,7,13],"text":"namespace Ebb"}
{"command":[9,0,11,25],"text":"/-- A quantified hypothesis stands as a block under its condition. -/\ntheorem none_all (h : forall n : Nat, n = 0) : False :=\n  absurd (h 1) (by omega)"}
{"command":[13,0,14,61],"text":"/-- An equivalence a conclusion holds stands as a block under it. -/\ntheorem iff_after (p q : Prop) (_hp : p) : q <-> q := Iff.rfl"}
{"command":[16,0,17,59],"text":"/-- An equivalence of conjunctions under a quantifier stands as a block, its sides bare. -/\ntheorem swap (p q : Prop) : And p q <-> And q p := And.comm"}
{"command":[19,0,21,57],"text":"/-- An equivalence a quantifier opens lists its two sides. -/\ntheorem all_iff (p : Prop) : (forall n : Nat, Or p (n = n)) <-> True :=\n  Iff.intro (fun _ => True.intro) (fun _ _ => Or.inr rfl)"}
{"command":[23,0,24,34],"text":"theorem neg_all : Not (forall n : Nat, n = 0) :=\n  fun h => absurd (h 1) (by omega)"}
{"command":[26,0,27,44],"text":"theorem both_all : And (forall n : Nat, 0 <= n) (exists m : Nat, m = m) :=\n  And.intro Nat.zero_le (Exists.intro 0 rfl)"}
{"command":[29,0,32,19],"text":"/-- List literals and a function ignoring its argument, as Lean writes them. -/\ntheorem list_lits :\n    And ([1, 2, 3].length = 3) (List.map (fun _ => 0) [5] = [0]) :=\n  And.intro rfl rfl"}
{"command":[34,0,35,20],"text":"theorem chain (a b c : Nat) (h1 : a <= b) (h2 : b <= c) : a <= c :=\n  Nat.le_trans h1 h2"}
{"command":[37,0,39,13],"text":"structure Barge where\n  hull : Nat\n  draft : Nat"}
{"command":[41,0,41,44],"text":"def Moored (b : Barge) : Prop := 0 < b.draft"}
{"command":[43,0,43,50],"text":"def nameOf (b : Barge) : String := toString b.hull"}
{"command":[45,0,53,49],"text":"/-- Three clauses over a list: a disjunction, a witness and a bound. -/\ntheorem harbor_log (bs : List Barge) :\n    And (forall b, Membership.mem bs b -> Or (b.draft = 0) (Moored b))\n      (And (forall s, Membership.mem (bs.map nameOf) s ->\n          exists b, And (Membership.mem bs b) (nameOf b = s))\n        (forall n : Nat, (bs.drop n).length <= bs.length)) :=\n  And.intro (fun b _ => by unfold Moored; omega)\n    (And.intro (fun _ h => List.mem_map.mp h)\n      (fun n => by rw [List.length_drop]; omega))"}
{"command":[55,0,64,29],"text":"/-- Three clauses, the second of two clauses its own. -/\ntheorem barge_bounds (bs : List Barge) (cap : Nat) :\n    And (forall b, Membership.mem bs b -> b.draft <= b.draft + cap)\n      (And (forall b, Membership.mem bs b ->\n          And (forall k : Nat, k < b.hull -> k + 1 <= b.hull)\n            (exists m : Nat, m = b.draft + cap))\n        (bs.length <= bs.length + cap)) :=\n  And.intro (fun _ _ => Nat.le_add_right _ _)\n    (And.intro (fun _ _ => And.intro (fun _ hk => hk) (Exists.intro _ rfl))\n      (Nat.le_add_right _ _))"}
{"command":[66,0,66,7],"text":"end Ebb"}
{"leantex-lean-export-end":12}
