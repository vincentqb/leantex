{"const":"instLTNat","binders":""}
{"const":"OfNat.ofNat","binders":"idc"}
{"const":"Eq","binders":"idd"}
{"const":"List.length","binders":"id","field":1}
{"const":"Not","binders":"d"}
{"const":"Ebb.Barge","binders":""}
{"const":"List.nil","binders":"i"}
{"command":[7,0,9,43],"text":"/-- Each statement of a list implies every other, as Mathlib's TFAE says. -/\ndef List.TFAE (l : List Prop) : Prop := forall x, Membership.mem l x ->\n  forall y, Membership.mem l y -> (x <-> y)"}
{"command":[11,0,11,13],"text":"namespace Ebb"}
{"command":[13,0,15,25],"text":"/-- A quantified hypothesis stands as a block under its condition. -/\ntheorem none_all (h : forall n : Nat, n = 0) : False :=\n  absurd (h 1) (by omega)"}
{"command":[17,0,18,61],"text":"/-- An equivalence a conclusion holds stands as a block under it. -/\ntheorem iff_after (p q : Prop) (_hp : p) : q <-> q := Iff.rfl"}
{"command":[20,0,21,59],"text":"/-- An equivalence of conjunctions under a quantifier stands as a block, its sides bare. -/\ntheorem swap (p q : Prop) : And p q <-> And q p := And.comm"}
{"command":[23,0,25,57],"text":"/-- An equivalence a quantifier opens lists its two sides. -/\ntheorem all_iff (p : Prop) : (forall n : Nat, Or p (n = n)) <-> True :=\n  Iff.intro (fun _ => True.intro) (fun _ _ => Or.inr rfl)"}
{"command":[27,0,28,34],"text":"theorem neg_all : Not (forall n : Nat, n = 0) :=\n  fun h => absurd (h 1) (by omega)"}
{"command":[30,0,31,44],"text":"theorem both_all : And (forall n : Nat, 0 <= n) (exists m : Nat, m = m) :=\n  And.intro Nat.zero_le (Exists.intro 0 rfl)"}
{"command":[33,0,36,19],"text":"/-- List literals and a function ignoring its argument, as Lean writes them. -/\ntheorem list_lits :\n    And ([1, 2, 3].length = 3) (List.map (fun _ => 0) [5] = [0]) :=\n  And.intro rfl rfl"}
{"command":[38,0,39,20],"text":"theorem chain (a b c : Nat) (h1 : a <= b) (h2 : b <= c) : a <= c :=\n  Nat.le_trans h1 h2"}
{"command":[41,0,43,13],"text":"structure Barge where\n  hull : Nat\n  draft : Nat"}
{"command":[45,0,45,44],"text":"def Moored (b : Barge) : Prop := 0 < b.draft"}
{"command":[47,0,47,50],"text":"def nameOf (b : Barge) : String := toString b.hull"}
{"command":[49,0,57,49],"text":"/-- Three clauses over a list: a disjunction, a witness and a bound. -/\ntheorem harbor_log (bs : List Barge) :\n    And (forall b, Membership.mem bs b -> Or (b.draft = 0) (Moored b))\n      (And (forall s, Membership.mem (bs.map nameOf) s ->\n          exists b, And (Membership.mem bs b) (nameOf b = s))\n        (forall n : Nat, (bs.drop n).length <= bs.length)) :=\n  And.intro (fun b _ => by unfold Moored; omega)\n    (And.intro (fun _ h => List.mem_map.mp h)\n      (fun n => by rw [List.length_drop]; omega))"}
{"command":[59,0,68,29],"text":"/-- Three clauses, the second of two clauses its own. -/\ntheorem barge_bounds (bs : List Barge) (cap : Nat) :\n    And (forall b, Membership.mem bs b -> b.draft <= b.draft + cap)\n      (And (forall b, Membership.mem bs b ->\n          And (forall k : Nat, k < b.hull -> k + 1 <= b.hull)\n            (exists m : Nat, m = b.draft + cap))\n        (bs.length <= bs.length + cap)) :=\n  And.intro (fun _ _ => Nat.le_add_right _ _)\n    (And.intro (fun _ _ => And.intro (fun _ hk => hk) (Exists.intro _ rfl))\n      (Nat.le_add_right _ _))"}
{"command":[70,0,72,14],"text":"/-- A hypothesis about the bound name alone reads as a relative clause. -/\ntheorem moored_draft : forall b : Barge, Moored b -> 0 < b.draft :=\n  fun _ h => h"}
{"command":[74,0,76,72],"text":"/-- An existential's first statement about its name reads as one too. -/\ntheorem some_moored : exists b : Barge, And (Moored b) (b.hull = 0) :=\n  Exists.intro (Barge.mk 0 1) (And.intro (by unfold Moored; decide) rfl)"}
{"command":[78,0,87,33],"text":"/-- Three equivalent statements, one a quantifier's, listed. -/\ntheorem parity (n : Nat) :\n    List.TFAE [n % 2 = 0, (n + 2) % 2 = 0,\n      forall k : Nat, k = n -> k % 2 = 0] := by\n  intro x hx y hy\n  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx hy\n  have h : (forall k : Nat, k = n -> k % 2 = 0) <-> n % 2 = 0 :=\n    Iff.intro (fun f => f n rfl) (fun e k hk => hk ▸ e)\n  rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl <;>\n    (try simp only [h]) <;> omega"}
{"command":[89,0,89,7],"text":"end Ebb"}
{"leantex-lean-export-end":16}
