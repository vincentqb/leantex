{"command":[6,0,6,13],"text":"namespace Ebb"}
{"command":[8,0,10,25],"text":"/-- A quantified hypothesis stands as a block under its condition. -/\ntheorem none_all (h : forall n : Nat, n = 0) : False :=\n  absurd (h 1) (by omega)"}
{"command":[12,0,13,61],"text":"/-- An equivalence a conclusion holds stands as a block under it. -/\ntheorem iff_after (p q : Prop) (_hp : p) : q <-> q := Iff.rfl"}
{"command":[15,0,16,59],"text":"/-- An equivalence of conjunctions under a quantifier sets each side a block deeper. -/\ntheorem swap (p q : Prop) : And p q <-> And q p := And.comm"}
{"command":[18,0,19,34],"text":"theorem neg_all : Not (forall n : Nat, n = 0) :=\n  fun h => absurd (h 1) (by omega)"}
{"command":[21,0,22,44],"text":"theorem both_all : And (forall n : Nat, 0 <= n) (exists m : Nat, m = m) :=\n  And.intro Nat.zero_le (Exists.intro 0 rfl)"}
{"command":[24,0,25,20],"text":"theorem chain (a b c : Nat) (h1 : a <= b) (h2 : b <= c) : a <= c :=\n  Nat.le_trans h1 h2"}
{"command":[27,0,27,7],"text":"end Ebb"}
{"leantex-lean-export-end":6}
